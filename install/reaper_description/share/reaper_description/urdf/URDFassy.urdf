<?xml version="1.0" encoding="utf-8"?>
<!-- Tracked version of Reaper model with original visuals restored -->
 <!-- generate the sdf with "ign sdf -p URDFassy.urdf > Reaper.sdf" -->
<robot name="URDFassy_tracked">

  <!-- Chassis Link -->
  <link name="Chassis">
    <inertial>
      <origin xyz="0.268041600725968 0.102021849345525 -6.48544629737818E-08" rpy="0 0 0" />
      <mass value="146.224560356707" />
      <inertia ixx="10.5200179364845" ixy="-1.93496024812939" ixz="1.65925274358814E-07"
        iyy="22.9867369537623" iyz="1.82289041966192E-06" izz="18.0208175606407" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://reaper_description/meshes/visual/Chassis.STL" />
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://reaper_description/meshes/visual/Chassis.STL" />
      </geometry>
    </collision>
  </link>

  <!-- What is a track but a collection of many smaller wheels -->
<link name="left_roller_1">
  <inertial>
    <!-- Centered on the wheel’s own frame -->
    <origin xyz="0 0 0" rpy="1.5708 1.5708 3.14159"/>
    <mass value="0.8"/>  <!-- your measured roller mass -->
    <inertia
      ixx="0.0065" ixy="0.0" ixz="0.0"
      iyy="0.0065" iyz="0.0"
      izz="0.0096"/>
  </inertial>

  <visual>
    <origin xyz="0 0 0" rpy="1.5708 1.5708 3.14159"/>
    <geometry>
      <!-- radius = 0.155 m, length = track width (e.g. 0.1 m) -->
      <cylinder radius="0.155" length="0.10"/>
    </geometry>
    <material name="black">
      <color rgba="0.1 0.1 0.1 1"/>
    </material>
  </visual>

  <collision>
    <origin xyz="0 0 0" rpy="1.5708 1.5708 3.14159"/>
    <geometry>
      <cylinder radius="0.155" length="0.10"/>
    </geometry>
  </collision>
</link>

<joint name="left_roller_1_joint" type="continuous">
  <!-- attach back to the chassis -->
  <parent link="Chassis"/>
  <child  link="left_roller_1"/>
  <!-- insert the real x,y,z of this roller -->
  <origin xyz="0.4 0.25 0" rpy="0 0 0"/>
  <axis xyz="0 1 0"/>
  <!-- add a little joint damping -->
  <dynamics damping="0.1" friction="0.01"/>
</joint>


<!-- Right rear roller -->
<link name="right_roller_1">
  <inertial>
    <!-- same rotation so cylinder axis is along X -->
    <origin xyz="0 0 0" rpy="1.5708 1.5708 3.14159"/>
    <mass value="0.8"/>
    <inertia
      ixx="0.0065" ixy="0.0" ixz="0.0"
      iyy="0.0065" iyz="0.0"
      izz="0.0096"/>
  </inertial>

  <visual>
    <!-- rotate so the cylinder’s length (width) is along X -->
    <origin xyz="0 0 0" rpy="1.5708 1.5708 3.14159"/>
    <geometry>
      <cylinder radius="0.155" length="0.10"/>
    </geometry>
    <material name="black">
      <color rgba="0.1 0.1 0.1 1"/>
    </material>
  </visual>

  <collision>
    <origin xyz="0 0 0" rpy="1.5708 1.5708 3.14159"/>
    <geometry>
      <cylinder radius="0.155" length="0.10"/>
    </geometry>
  </collision>
</link>

<joint name="right_roller_1_joint" type="continuous">
  <parent link="Chassis"/>
  <child  link="right_roller_1"/>
  <!-- mirrored Y position -->
  <origin xyz="0.4 -0.25 0" rpy="0 0 0"/>
  <axis xyz="0 1 0"/>
  <dynamics damping="0.1" friction="0.01"/>
</joint>

<!-- Front left roller -->
<link name="left_roller_2">
  <inertial>
    <origin xyz="0 0 0" rpy="1.5708 1.5708 3.14159"/>
    <mass value="0.8"/>
    <inertia
      ixx="0.0065" ixy="0.0" ixz="0.0"
      iyy="0.0065" iyz="0.0"
      izz="0.0096"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="1.5708 1.5708 3.14159"/>
    <geometry>
      <cylinder radius="0.155" length="0.10"/>
    </geometry>
    <material name="black">
      <color rgba="0.1 0.1 0.1 1"/>
    </material>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5708 1.5708 3.14159"/>
    <geometry>
      <cylinder radius="0.155" length="0.10"/>
    </geometry>
  </collision>
</link>

<joint name="left_roller_2_joint" type="continuous">
  <parent link="Chassis"/>
  <child  link="left_roller_2"/>
  <!-- moved +0.5 m forward from the rear roller -->
  <origin xyz="-0.1 0.25 0" rpy="0 0 0"/>
  <axis xyz="0 1 0"/>
  <dynamics damping="0.1" friction="0.01"/>
</joint>

<!-- Front right roller -->
<link name="right_roller_2">
  <inertial>
    <origin xyz="0 0 0" rpy="1.5708 1.5708 3.14159"/>
    <mass value="0.8"/>
    <inertia
      ixx="0.0065" ixy="0.0" ixz="0.0"
      iyy="0.0065" iyz="0.0"
      izz="0.0096"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="1.5708 1.5708 3.14159"/>
    <geometry>
      <cylinder radius="0.155" length="0.10"/>
    </geometry>
    <material name="black">
      <color rgba="0.1 0.1 0.1 1"/>
    </material>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5708 1.5708 3.14159"/>
    <geometry>
      <cylinder radius="0.155" length="0.10"/>
    </geometry>
  </collision>
</link>

<joint name="right_roller_2_joint" type="continuous">
  <parent link="Chassis"/>
  <child  link="right_roller_2"/>
  <origin xyz="-0.1 -0.25 0" rpy="0 0 0"/>
  <axis xyz="0 1 0"/>
  <dynamics damping="0.1" friction="0.01"/>
</joint>


  <!-- Linkage Link -->
  <link name="Linkage">
    <inertial>
      <origin xyz="-0.163261636855882 -0.165382057279213 5.27223021939055E-17" rpy="0 0 0" />
      <mass value="1.57934542654535" />
      <inertia ixx="0.0206926077974767" ixy="-0.0199107734055339" ixz="-3.58706485090842E-19"
        iyy="0.0202092785023025" iyz="-1.26737522063389E-19" izz="0.0404826417999642" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://reaper_description/meshes/visual/Linkage.STL" />
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://reaper_description/meshes/visual/Linkage.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Bucket Link -->
  <link name="Bucket">
    <inertial>
      <origin xyz="-0.00221313093485331 -0.0160077237789516 -6.72159216717413E-16" rpy="0 0 0" />
      <mass value="10.7696762355229" />
      <inertia ixx="0.352455755561628" ixy="-0.0833393361479293" ixz="-4.80945718975859E-17"
        iyy="0.508758902375544" iyz="4.84925708785236E-17" izz="0.288540549981325" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://reaper_description/meshes/visual/Bucket.STL" />
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://reaper_description/meshes/visual/Bucket.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Joint: Chassis to Linkage -->
  <joint name="joint_Linkage" type="revolute">
    <origin xyz="-0.33975 0 0.23217" rpy="1.5708 0.26832 0" />
    <parent link="Chassis" />
    <child link="Linkage" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1" upper="0.55" effort="100" velocity="5.0" />
      <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Joint: Linkage to Bucket -->
  <joint name="joint_Bucket" type="revolute">
    <origin xyz="-0.29504 -0.29876 0" rpy="0 0 0.5499" />
    <parent link="Linkage" />
    <child link="Bucket" />
    <axis xyz="0 0 1" />
    <limit lower="-2.40" upper="1.05" effort="100" velocity="5.0" />
      <dynamics damping="0.5" friction="0.1"/>
  </joint>
<gazebo>
  <plugin filename="ignition-gazebo-diff-drive-system"
          name="gz::sim::systems::DiffDrive">
    <left_joint>left_roller_1_joint</left_joint>
    <left_joint>left_roller_2_joint</left_joint>
    <right_joint>right_roller_1_joint</right_joint>
    <right_joint>right_roller_2_joint</right_joint>
    <wheel_separation>0.65</wheel_separation>
    <wheel_radius>0.155</wheel_radius>
    <topic>cmd_vel</topic>
    <ros>
      <namespace>/</namespace>
    </ros>
  </plugin>
</gazebo>

</robot>