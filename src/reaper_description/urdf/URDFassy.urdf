<?xml version="1.0" encoding="utf-8"?>
<!-- Tracked version of Reaper model with original visuals restored -->
<robot name="URDFassy_tracked">

  <!-- Chassis Link -->
  <link name="Chassis">
    <inertial>
      <origin xyz="0.268041600725968 0.102021849345525 -6.48544629737818E-08" rpy="0 0 0"/>
      <mass value="146.224560356707"/>
      <inertia ixx="10.5200179364845" ixy="-1.93496024812939" ixz="1.65925274358814E-07" iyy="22.9867369537623" iyz="1.82289041966192E-06" izz="18.0208175606407"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://reaper_description/meshes/visual/Chassis.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://reaper_description/meshes/visual/Chassis.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- Linkage Link -->
  <link name="Linkage">
    <inertial>
      <origin xyz="-0.163261636855882 -0.165382057279213 5.27223021939055E-17" rpy="0 0 0"/>
      <mass value="1.57934542654535"/>
      <inertia ixx="0.0206926077974767" ixy="-0.0199107734055339" ixz="-3.58706485090842E-19" iyy="0.0202092785023025" iyz="-1.26737522063389E-19" izz="0.0404826417999642"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://reaper_description/meshes/visual/Linkage.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://reaper_description/meshes/visual/Linkage.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- Bucket Link -->
  <link name="Bucket">
    <inertial>
      <origin xyz="-0.00221313093485331 -0.0160077237789516 -6.72159216717413E-16" rpy="0 0 0"/>
      <mass value="10.7696762355229"/>
      <inertia ixx="0.352455755561628" ixy="-0.0833393361479293" ixz="-4.80945718975859E-17" iyy="0.508758902375544" iyz="4.84925708785236E-17" izz="0.288540549981325"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://reaper_description/meshes/visual/Bucket.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://reaper_description/meshes/visual/Bucket.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint: Chassis to Linkage -->
  <joint name="joint_Linkage" type="revolute">
    <origin xyz="-0.33975 0 0.23217" rpy="1.5708 0.26832 0"/>
    <parent link="Chassis"/>
    <child link="Linkage"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1" upper="0.55" effort="100" velocity="5.0"/>
  </joint>

  <!-- Joint: Linkage to Bucket -->
  <joint name="joint_Bucket" type="revolute">
    <origin xyz="-0.29504 -0.29876 0" rpy="0 0 0.5499"/>
    <parent link="Linkage"/>
    <child link="Bucket"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.40" upper="1.05" effort="100" velocity="5.0"/>
  </joint>

  <!-- Left Track Link -->
  <link name="left_track">
    <inertial>
      <origin xyz="0 0.260 -0.15" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.1 0.1"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.1 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- Right Track Link -->
  <link name="right_track">
    <inertial>
      <origin xyz="0 -0.260 -0.15" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.1 0.1"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.1 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- Joints for Tracks -->
  <joint name="left_track_joint" type="continuous">
    <parent link="Chassis"/>
    <child link="left_track"/>
    <origin xyz="0 0.260 -0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_track_joint" type="continuous">
    <parent link="Chassis"/>
    <child link="right_track"/>
    <origin xyz="0 -0.260 -0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Diff Drive Plugin (Gazebo Sim) -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_track_joint</left_joint>
      <right_joint>right_track_joint</right_joint>
      <wheel_separation>0.650</wheel_separation>
      <wheel_radius>0.254</wheel_radius>
      <max_linear_acceleration>1</max_linear_acceleration>
      <min_linear_acceleration>-1</min_linear_acceleration>
      <max_angular_acceleration>2</max_angular_acceleration>
      <min_angular_acceleration>-2</min_angular_acceleration>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>1</max_angular_velocity>
      <min_angular_velocity>-1</min_angular_velocity>
      <topic>cmd_vel</topic>
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
  </gazebo>

  <!-- ros2_control unchanged -->

</robot>
